#!/bin/zsh

if [[ -f "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

if [[ -f "$HOME/.ssh/ca-bundle.crt" ]]; then
  export NODE_EXTRA_CA_CERTS=$HOME/.ssh/ca-bundle.crt
fi

export XDG_CONFIG_HOME="$HOME/.config"
export PATH="$HOME/.config/bin:$HOME/.local/bin:$HOME/.mint/bin:$HOME/.cargo/bin:$PATH"

export OLLAMA_HOST=http://blackpearl.local:12345

source "$HOME/.config/zsh/system-theme"
source "$HOME/.config/zsh/alias"

